# Raahi Mobility Backend — environment template
# Copy to .env and fill in. Secrets NEVER go in git or mobile apps (spec 05 §13).

# ── Server ──
NODE_ENV=development
PORT=4500
HOST=0.0.0.0
APP_NAME=Raahi Mobility
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Auth (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_LENGTH_REQUIRED
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_LENGTH_REQUIRED
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
# AES-256-GCM key for provider secrets at rest (32+ chars)
SETTINGS_ENCRYPTION_KEY=

# ── PostgreSQL (PostGIS required) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=raahi_db
DB_USER=raahi_user
DB_PASSWORD=raahi_password_dev
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT=10000

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_COMMAND_TIMEOUT_MS=2000

# ── OTP / SMS ──
SMS_PROVIDER=none
TWO_FACTOR_API_KEY=
TWO_FACTOR_TEMPLATE=RaahiRideOTP
ALLOW_DEMO_OTP=true
DEMO_OTP_CODE=123456

# ── Dispatch ──
DISPATCH_WAVE_RADIUS_M=1500,3000,6000
DISPATCH_WAVE_SIZE=8,16,32
DISPATCH_OFFER_TTL_S=12
DISPATCH_MAX_SEARCH_S=45

# ── Location cadence (ms) ──
LOCATION_MIN_INTERVAL_IDLE_MS=15000
LOCATION_MIN_INTERVAL_TO_PICKUP_MS=5000
LOCATION_MIN_INTERVAL_ON_TRIP_MS=3000

# ── Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Ola Maps (server-side ONLY — never ship to apps) ──
OLA_MAPS_API_KEY=

# ── Cloudinary (private KYC / safety evidence) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── FCM ──
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Worker process type: general | dispatch | notification | payments | safety | all ──
WORKER_PROCESS=general

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true
